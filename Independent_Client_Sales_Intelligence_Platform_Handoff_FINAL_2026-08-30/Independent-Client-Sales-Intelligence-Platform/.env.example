HUNTER_API_KEY=your_hunter_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# White-label identity (non-secret)
COMPANY_NAME=Client Company
COMPANY_WEBSITE=https://example.com
COMPANY_PROFILE=Replace this with a verified description of the client company and its products.
COMPANY_EMAIL_DOMAIN=example.com

# Lead outreach mailbox
OUTREACH_MAIL_EMAIL=sales@example.com
OUTREACH_MAIL_PASSWORD=replace-with-mailbox-app-password
OUTREACH_SMTP_HOST=smtp.example.com
OUTREACH_SMTP_PORT=465
OUTREACH_IMAP_HOST=imap.example.com
OUTREACH_IMAP_PORT=993

# Stock campaign mailbox
STOCK_MAIL_EMAIL=stock@example.com
STOCK_MAIL_SECURITY_PASSWORD=replace-with-mailbox-app-password
STOCK_SMTP_HOST=smtp.example.com
STOCK_SMTP_PORT=465
STOCK_IMAP_HOST=imap.example.com
STOCK_IMAP_PORT=993

# Generative copy provider
GEMINI_API_KEY=replace-with-provider-key
GEMINI_MODEL=gemini-3.5-flash-lite
